# Solo desarrollo local. Copiar a .env y generar SECRET_KEY con secrets.token_urlsafe(50).
SECRET_KEY=reemplazar-con-una-clave-aleatoria-de-al-menos-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío usa SQLite; Render lo recibe automáticamente del Blueprint.
DATABASE_URL=
# Opcionales para initialize_deployment. Nunca publicar la contraseña.
LOAD_DEMO_DATA=False
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
