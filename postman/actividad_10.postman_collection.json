              "pm.test(\"Personajes del usuario sin FK expuesta\", () => { const ps = pm.response.json(); pm.expect(ps).to.be.an(\"array\").that.is.not.empty; ps.forEach(p => { pm.expect(p.id).to.be.a(\"number\"); pm.expect(p).not.to.have.property(\"perfil_id\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Detalle con niveles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/personajes/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Habilidades con nivel\", () => { pm.expect(pm.response.json().habilidades[0].nivel).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Crear personaje temporal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/personajes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"perfil_id\": 1,\n  \"nombre\": \"Prueba Postman\",\n  \"descripcion\": \"Personaje temporal de verificación\",\n  \"ataque\": 20,\n  \"defensa\": 30,\n  \"estamina\": 40,\n  \"tipo\": \"guerrero\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"personaje_id\", pm.response.json().id);",
              "pm.test(\"Atributos iniciales\", () => { pm.expect(pm.response.json().ataque).to.eql(20); });",
              "pm.test(\"Sanitiza FK real y conserva contenido\", () => { const p = pm.response.json(); pm.expect(p).not.to.have.property(\"perfil_id\"); pm.expect(p.id).to.be.a(\"number\"); pm.expect(p.atributos_base).to.eql({ataque:20,defensa:30,estamina:40}); pm.expect(p.habilidades).to.eql([]); });"
            ]
          }
        }
      ]
    },
