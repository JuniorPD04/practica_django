          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista persistida\", () => { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
            ]
          }
        }
      ]
    },
