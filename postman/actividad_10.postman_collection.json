    {
      "name": "46 - Comprobar registros de GET POST PUT DELETE y errores en BD",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/request-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cada llamada tiene su fila persistida en request_log\", () => {",
              "  const rows = pm.response.json(); const expected = JSON.parse(pm.collectionVariables.get(\"logs_pendientes\"));",
              "  pm.expect(rows).to.be.an(\"array\").that.is.not.empty;",
              "  expected.forEach(e => { const row = rows.find(r => r.id === e.id); pm.expect(row, JSON.stringify(e)).to.be.an(\"object\"); pm.expect(row.method).to.eql(e.method); pm.expect(row.path).to.eql(e.path); pm.expect(row).to.have.property(\"ip\"); pm.expect(row.called_at).to.be.a(\"string\"); });",
              "});",
              "pm.collectionVariables.set(\"logs_pendientes\", \"[]\");"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.iteration === 0 && pm.info.requestName.startsWith(\"01 -\")) {",
          "  pm.collectionVariables.set(\"logs_pendientes\", \"[]\");",
          "  pm.collectionVariables.unset(\"personaje_id\");",
          "  pm.collectionVariables.unset(\"habilidad_id\");",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const logId = pm.response.headers.get(\"X-Request-Log-Id\");",
          "pm.test(\"Logging: identificador de registro persistido\", () => pm.expect(logId).to.match(/^\\d+$/));",
          "const pendientes = JSON.parse(pm.collectionVariables.get(\"logs_pendientes\") || \"[]\");",
          "pendientes.push({id: Number(logId), method: pm.request.method, path: require(\"url\").parse(pm.variables.replaceIn(pm.request.url.toString())).pathname});",
          "pm.collectionVariables.set(\"logs_pendientes\", JSON.stringify(pendientes));",
          "if ((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\")) {",
          "  pm.test(\"Sanitización: ninguna clave termina en _id, en ningún nivel\", () => {",
          "    function revisar(v) { if (Array.isArray(v)) v.forEach(revisar); else if (v && typeof v === \"object\") Object.keys(v).forEach(k => { pm.expect(k.endsWith(\"_id\"), k).to.eql(false); revisar(v[k]); }); }",
          "    revisar(pm.response.json());",
          "  });",
          "}",
          "if (pm.response.code === 204) pm.test(\"DELETE conserva respuesta vacía\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
        ]
      }
    }
  ]
}
