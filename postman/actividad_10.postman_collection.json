{
  "info": {
    "name": "10 - Controllers, Validators y Middlewares - Juego",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con Collection Runner. Requiere migrate, datos_iniciales y DEBUG=True. Valida CRUD, errores por campo, sanitización recursiva y persistencia de logs de cada llamada. Crea y elimina sus recursos temporales. No altera el fixture. Los logs se conservan como evidencia. base_url incluye /api; perfil_id=1 pertenece al fixture. Al interrumpir pueden quedar recursos temporales."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "personaje_id",
      "value": ""
    },
    {
      "key": "habilidad_id",
      "value": ""
    },
    {
      "key": "logs_pendientes",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "01 - Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Sin contraseñas\", () => { pm.expect(pm.response.json()[0]).not.to.have.property(\"contrasena\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar personajes",
      "request": {
        "method": "GET",
        "header": [],
