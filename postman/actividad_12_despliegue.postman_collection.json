    {
      "name": "05 - Login ADMIN y guardar tokens",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login/",
        "description": "Estado esperado: 200. Los IDs de consulta presuponen el seed del taller.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"access_token\"); pm.collectionVariables.unset(\"refresh_token\");",
              "const username = pm.variables.get(\"username\"), password = pm.variables.get(\"password\");",
              "if (!username || !password) { throw new Error(\"Completa username y password con la cuenta ADMIN de Django antes del login.\"); }",
              "pm.request.body.update(JSON.stringify({username, password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test(\"JWT access y refresh recibidos\", () => { pm.expect(data.access).to.be.a(\"string\").and.not.empty; pm.expect(data.refresh).to.be.a(\"string\").and.not.empty; });",
              "  if (data.access && data.refresh) { pm.collectionVariables.set(\"access_token\", data.access); pm.collectionVariables.set(\"refresh_token\", data.refresh); }",
              "}"
            ]
          }
        }
      ]
    },
