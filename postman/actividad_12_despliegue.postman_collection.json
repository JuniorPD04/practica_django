  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get(\"base_url\");",
          "if (!base || !/^https?:\\/\\/[^\\s]+$/.test(base) || /\\/$/.test(base) || /\\/api$/.test(base)) { throw new Error(\"Configura base_url con la URL base sin /api ni barra final.\"); }"
        ]
      }
    }
