{
  "info": {
    "name": "09 - Modelo de Base de Datos - Juego",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato ejecutable de la actividad 09. Ejecutar en orden tras migrate y loaddata datos_iniciales. Crea y elimina sus recursos temporales. No modifica los personajes del fixture."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "personaje_id",
      "value": ""
    },
    {
      "key": "habilidad_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Sin contraseñas\", () => { pm.expect(pm.response.json()[0]).not.to.have.property(\"contrasena\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar personajes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/personajes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista persistida\", () => { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Personajes del usuario",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/1/personajes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Perfil del usuario 1\", () => { pm.response.json().forEach(p => pm.expect(p.perfil_id).to.eql(1)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Detalle con niveles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/personajes/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Habilidades con nivel\", () => { pm.expect(pm.response.json().habilidades[0].nivel).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Crear personaje temporal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/personajes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"perfil_id\": 1,\n  \"nombre\": \"Prueba Postman\",\n  \"descripcion\": \"Personaje temporal de verificación\",\n  \"ataque\": 20,\n  \"defensa\": 30,\n  \"estamina\": 40\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"personaje_id\", pm.response.json().id);",
              "pm.test(\"Atributos iniciales\", () => { pm.expect(pm.response.json().ataque).to.eql(20); });"
            ]
          }
        }
      ]
    },
